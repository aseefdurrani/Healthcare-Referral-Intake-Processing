# Placeholders only. Copy to backend/.env for local work. Never commit .env.
APP_ENV=local
APP_VERSION=dev
AWS_REGION=us-east-2
AWS_PROFILE=<your-aws-login-profile>
LOG_LEVEL=INFO
LOG_SINK=stdout
S3_BUCKET_NAME=<private-referrals-bucket>
S3_SSE_MODE=AES256
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=intake
DB_USER=intake_app
DB_PASSWORD=<local-password>
DB_SSLMODE=disable
# Non-local hosts use verify-full and certs/us-east-2-bundle.pem.
DB_SSLROOTCERT=
COGNITO_USER_POOL_ID=us-east-2_EXAMPLE
COGNITO_APP_CLIENT_ID=<app-client-id>
ALLOWED_STAFF_SUB=00000000-0000-0000-0000-000000000000
AI_ENABLED=true
# Create a project API key and put it only in backend/.env (never in Next.js).
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-6.1-terra
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_RETRY_MAX_OUTPUT_TOKENS=12000
OPENAI_MAX_INPUT_CHARS=120000
TEXTRACT_FEATURE_TYPES=LAYOUT,FORMS,TABLES
MAX_UPLOAD_BYTES=10000000
MAX_PDF_PAGES=10
PROCESSING_MAX_WORKERS=2
PROCESSING_RUN_TIMEOUT_SECONDS=300
PROCESSING_MAX_ATTEMPTS=3
TEXTRACT_USD_PER_PAGE=0.065
OPENAI_INPUT_USD_PER_1M_TOKENS=1.00
OPENAI_OUTPUT_USD_PER_1M_TOKENS=5.00
PRICING_RATES_AS_OF=2026-11-11
